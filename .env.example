# Application Configuration
NODE_ENV=development
PORT=18082
APP_NAME=Flux
APP_VERSION=1.0.0
LOG_LEVEL=info
TZ=UTC

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_DB=flux_db
POSTGRES_USER=flux_user
POSTGRES_PASSWORD=flux_password
POSTGRES_MAX_CONNECTIONS=20
DATABASE_URL=postgres://flux_user:flux_password@localhost:15433/flux_db

# Redis Cache / Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# Adminer Database GUI
ADMINER_PORT=18086
